# Alibaba Cloud Production Environment
# Copy to .env on the ECS instance. Never commit .env.

# === Server ===
NODE_ENV=production
PORT=8000
TRUST_PROXY_HOPS=1

# === Auth (REQUIRED) ===
# Generate: openssl rand -hex 64
JWT_SECRET=
# JWT_EXPIRES_IN=7d

# === Database ===
PERSISTENCE_ADAPTER=mongodb
AUTH_PROVIDER=mongodb
MONGODB_URI=mongodb://localhost:27017/ai-doctor

# === AI Providers ===
# At least one is required
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ERNIE_API_KEY=
# ERNIE_SECRET_KEY=
# QWEN_API_KEY=
# DEFAULT_AI_PROVIDER=qwen
# DEFAULT_AI_MODEL=
DEPLOYMENT_REGION=china

# === Firebase (optional, for legacy auth / GCS) ===
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_API_KEY=

# === Alibaba Cloud SMS ===
ALIBABA_SMS_ACCESS_KEY_ID=
ALIBABA_SMS_ACCESS_KEY_SECRET=
ALIBABA_SMS_SIGN_NAME=AI医生
ALIBABA_SMS_TEMPLATE_CODE=
ALIBABA_SMS_REGION=cn-hangzhou

# === Alibaba Cloud Content Moderation (Green API) ===
# Optional — degrades gracefully when not configured
# ALIBABA_GREEN_ACCESS_KEY_ID=
# ALIBABA_GREEN_ACCESS_KEY_SECRET=
# ALIBABA_GREEN_REGION=cn-shanghai
# ALIBABA_GREEN_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com

# === WeChat Official Account ===
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
# WECHAT_DAILY_REPORT_TEMPLATE_ID=
# WECHAT_MEDICATION_REMINDER_TEMPLATE_ID=
# WECHAT_ALERT_TEMPLATE_ID=

# === WeChat Pay ===
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/opt/ai-doctor-agent/certs/wechat_pay_private.pem
WECHAT_PAY_PLATFORM_CERT_PATH=/opt/ai-doctor-agent/certs/wechat_pay_platform.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/payment/callback/wechat/notify

# === Alipay ===
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.com/payment/callback/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.com/subscription

# === Email (password reset) ===
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# PASSWORD_RESET_URL=https://your-domain.com

# === Telegram (optional) ===
# TELEGRAM_BOT_TOKEN=

# === Internal cron ===
INTERNAL_CRON_BEARER_TOKEN=
CRON_DAILY_REPORT_USER_EMAILS=
CRON_DAILY_REPORT_LANGUAGE=zh

# === Observability ===
LOG_LEVEL=info
# SENTRY_DSN=

# === Privacy & Consent ===
# PRIVACY_POLICY_VERSION=2026-10-12
# CONSENT_ENFORCE=true

# === CORS / Frontend ===
# Set if frontend is on a different domain (e.g., CDN)
# FRONTEND_URL=https://your-cdn-domain.com
