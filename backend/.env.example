# Copy to .env and fill values. Never commit .env.

# --- Firebase / app (required for buildAIContext + reports) ---
FIREBASE_API_KEY=
# Add other Firebase / service keys your backend expects.

# --- Auth (REQUIRED) ---
# 服务启动时强制校验：缺失、使用占位值或短于 32 字符都会导致进程退出。
# 生成方式: openssl rand -hex 64
JWT_SECRET=
# 可选，默认 7d
# JWT_EXPIRES_IN=7d

# --- 找回密码 ---
# 前端重置页地址，邮件里的链接会带上 ?resetToken=
# PASSWORD_RESET_URL=http://localhost:3000
# 令牌有效期（分钟），默认 60
# PASSWORD_RESET_TTL_MINUTES=60
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- 可观测性 ---
# 日志级别: fatal|error|warn|info|debug|trace（生产默认 info，开发默认 debug）
# LOG_LEVEL=info

# 错误上报（可选）。配置 DSN 并 `npm i @sentry/node` 后生效；
# 不配置时错误仍会写入结构化日志，只是不外发。
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# 审计留痕的内容保留级别：
#   digest  —— 只存输入输出的 SHA-256，最小化 PHI 留存
#   summary —— 存截断摘要（默认，够人工复盘）
#   full    —— 存完整原文，合规要求严格时用，需配套访问控制与加密存储
# AUDIT_CAPTURE=summary
# AUDIT_SUMMARY_MAX_CHARS=2000

# --- 限流 (express-rate-limit) ---
# 反向代理跳数。Railway / Vercel 前有一层代理时为 1；本地直连留空。
# 不要设成 true —— 那等于无条件相信客户端伪造的 X-Forwarded-For，限流会被绕过。
TRUST_PROXY_HOPS=1

# 各档阈值，留空则用代码默认值。窗口单位为毫秒。
# 兜底闸门：所有 /api，默认 300 次 / 15 分钟
# RATE_LIMIT_GENERAL_MAX=300
# 认证接口：/api/auth 全量，默认 30 次 / 15 分钟（按 IP）
# RATE_LIMIT_AUTH_MAX=30
# 登录失败：默认 5 次 / 15 分钟（按 IP + 账号，成功不计数）
# RATE_LIMIT_LOGIN_MAX=5
# 注册：默认 5 次 / 小时（按 IP）
# RATE_LIMIT_REGISTER_MAX=5
# AI 写接口：默认 60 次 / 小时（按用户）
# RATE_LIMIT_AI_MAX=60
# 多模态/文件分析：默认 20 次 / 小时（按用户）
# RATE_LIMIT_AI_HEAVY_MAX=20

# 仅非生产可用：本地联调时关闭限流。生产环境该变量被忽略。
# RATE_LIMIT_DISABLED=true

# --- HTTP server ---
PORT=8000

# --- Internal cron: POST /internal/cron/daily-report ---
# Bearer must match what the caller sends (e.g. trigger-node-daily-report.sh DOCTOR_AGENT_DAILY_WEBHOOK_TOKEN).
INTERNAL_CRON_BEARER_TOKEN=
# Optional alias read by internalCronAuth if INTERNAL_CRON_BEARER_TOKEN unset:
# DOCTOR_AGENT_DAILY_WEBHOOK_TOKEN=

# Users to include when the POST body omits userEmails (comma-separated real emails).
CRON_DAILY_REPORT_USER_EMAILS=jianfengren.sd@gmail.com

# Daily report language: en | zh (also uses userSettings.language per user)
CRON_DAILY_REPORT_LANGUAGE=en

# Telegram Bot API token used by dailyReportCronService.sendTelegramSummary.
# Use the bot that is allowed to message the user; chat_id comes from userSettings.integrations.telegramChatId.
TELEGRAM_BOT_TOKEN=

# --- Optional: Telegram bind webhook (separate from Hermes chat bot) ---
# TELEGRAM_WEBHOOK_SECRET=
