rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 允许已认证用户读写个人健康档案文件
    match /personal-health-records/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // 允许已认证用户读写健康记录文件
    match /health-records/{userId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // 允许已认证用户读写用户健康文档
    match /users/{userId}/health-documents/{fileName} {
      allow read, write: if request.auth != null;
    }
    
    // 默认规则：拒绝所有其他访问
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
