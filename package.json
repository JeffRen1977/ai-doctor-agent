{
  "name": "ai-doctor-agent",
  "version": "1.0.0",
  "description": "AI个人医生助理全栈应用",
  "private": true,
  "main": "backend/src/index.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon backend/src/index.js",
    "dev:mobile": "vite --host 0.0.0.0 --port 3000",
    "dev:full": "node scripts/start-mobile-dev.js",
    "dev:simple": "npm run dev:mobile",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/start-railway.js",
    "start:railway": "node scripts/start-railway.js",
    "start:backend": "node backend/src/index.js",
    "test": "jest --testPathIgnorePatterns=node_modules",
    "test:unit": "jest backend/src --testPathIgnorePatterns=node_modules",
    "test:login": "node scripts/test-login.js",
    "test:language": "node scripts/test-language-sync.js",
    "test:mongodb": "node scripts/test-mongodb-health-summary.js",
    "fix:deployment": "node scripts/fix-deployment-errors.js",
    "deploy:railway": "./scripts/deploy-railway.sh",
    "deploy:vercel": "./scripts/deploy-vercel.sh",
    "deploy:quick": "./scripts/quick-deploy.sh",
    "trigger:vercel": "node scripts/trigger-vercel-deploy.js",
    "railway:env": "./scripts/generate-railway-env.sh",
    "lint": "eslint frontend --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "mobile:serve": "http-server dist -p 3000 -c-1 --cors"
  },
  "dependencies": {
    "@ant-design/icons": "^5.0.0",
    "@ant-design/plots": "^2.6.3",
    "@google-cloud/storage": "^7.17.0",
    "@google/generative-ai": "^0.24.1",
    "antd": "^5.0.0",
    "axios": "^1.3.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "fhir-kit-client": "^1.9.2",
    "firebase": "^12.1.0",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "lucide-react": "^0.539.0",
    "mammoth": "^1.6.0",
    "mongodb": "^6.21.0",
    "mongoose": "^7.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-fetch": "^3.3.2",
    "openai": "^4.0.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.8.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.50.0",
    "@typescript-eslint/parser": "^5.50.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^7.6.0",
    "eslint": "^8.34.0",
    "http-server": "^14.1.1",
    "jest": "^29.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3",
    "terser": "^5.28.1",
    "typescript": "^4.9.0",
    "vite": "^8.0.0"
  },
  "author": "Jeffren",
  "license": "MIT",
  "jest": {
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
